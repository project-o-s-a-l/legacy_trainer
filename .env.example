POSTGRES_DB=legacy_trainer_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

FRONTEND_ORIGINS=https://localhost:5173,https://localhost:3000
COOKIE_SECURE=true
VITE_API_BASE_URL=https://localhost:8000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

VERIFICATION_CODE_TTL_MINUTES=10
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

CHECK_TIMEOUT_SECONDS=5
CHECK_DOCKER_MEMORY_LIMIT=256m
CHECK_DOCKER_CPUS=1.0
CHECK_DOCKER_PIDS_LIMIT=64
CHECK_DOCKER_TMPFS_SIZE=64m
CHECKER_SANDBOX_IMAGE=legacy-trainer-checker:local
CHECKER_DOCKER_BIN=docker
CHECKER_SANDBOX_CPUS=0.5
CHECKER_SANDBOX_MEMORY=256m
CHECKER_SANDBOX_PIDS_LIMIT=128
CHECKER_SANDBOX_USER=10001:10001
CHECKER_SANDBOX_TMPFS_SIZE=64m
CHECKER_SANDBOX_WORKSPACE_TMPFS_SIZE=64m
CHECKER_SANDBOX_TIMEOUT_OVERHEAD_SECONDS=3
CHECKER_SANDBOX_CLEANUP_TIMEOUT_SECONDS=5
