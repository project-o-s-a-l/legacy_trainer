POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/legacy_trainer
DB_ECHO=false

SECRET_KEY=change_me
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

FRONTEND_ORIGINS=https://localhost:3000,https://localhost:5173
COOKIE_SECURE=true
BACKEND_PORT=8000
BACKEND_SSL_CERTFILE=/app/certs/localhost.pem
BACKEND_SSL_KEYFILE=/app/certs/localhost-key.pem
FRONTEND_PORT=3000
VITE_API_BASE_URL=https://localhost:8000
VITE_DEV_HTTPS=true

